{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allows the main Via window to invoke its local Rust backend.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:1420/*"]
  },
  "permissions": [
    "core:event:default",
    "dialog:allow-open",
    "allow-load-config",
    "allow-save-config",
    "allow-delete-session",
    "allow-delete-group",
    "allow-delete-rule",
    "allow-create-group",
    "allow-export-config",
    "allow-import-config",
    "allow-save-session-secret",
    "allow-secret-store-status",
    "allow-initialize-secrets",
    "allow-unlock-secrets",
    "allow-recover-secrets",
    "allow-lock-secrets",
    "allow-approve-host-key",
    "allow-connect-session",
    "allow-disconnect-session",
    "allow-start-rule",
    "allow-stop-rule",
    "allow-start-enabled-rules",
    "allow-stop-session-rules",
    "allow-poll-transports"
  ]
}
